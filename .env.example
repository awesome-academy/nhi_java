# Copy sang .env rồi điền giá trị. Docker Compose tự đọc file .env ở thư mục này.
# Chạy local (không Docker): set -a; source .env; set +a; ./mvnw spring-boot:run

# BẮT BUỘC — sinh khoá: openssl rand -base64 32
JWT_SECRET=

# Tuỳ chọn (dưới đây là giá trị mặc định)
JWT_EXPIRATION=86400000
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW=60

# Chỉ dùng khi chạy local ngoài Docker
DB_URL=jdbc:postgresql://localhost:5432/tripgo
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Chỉ dùng cho docker-compose
POSTGRES_DB=tripgo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Cổng Postgres publish ra máy host; đổi nếu máy đã có Postgres chiếm 5432
DB_PORT=5432

# --- Tài khoản quản trị đầu tiên ---
# Tạo lúc khởi động nếu email chưa có trong DB. Bỏ trống -> không tạo.
# Chỉ tạo mới, không ghi đè tài khoản đã tồn tại.
ADMIN_EMAIL=admin@tripgo.local
ADMIN_PASSWORD=
ADMIN_NAME="Quản trị viên"

# --- Đăng nhập Facebook (tuỳ chọn) ---
# Lấy ở https://developers.facebook.com/apps -> App settings -> Basic.
# Bỏ trống -> tính năng không bật, app vẫn chạy với đăng nhập email/mật khẩu.
# Trong app Facebook, thêm Valid OAuth Redirect URI:
#   http://localhost:8080/login/oauth2/code/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Có giá trị -> sau khi đăng nhập xong redirect về đây kèm ?token=<JWT>.
# Bỏ trống -> callback trả thẳng JSON { token, user }.
OAUTH2_SUCCESS_REDIRECT_URI=
